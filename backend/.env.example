PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Atlas: mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/ledger?retryWrites=true&w=majority
# Transactions REQUIRE a replica set (Atlas works; plain local mongod does not)
MONGO_URI=

JWT_SECRET=change-me-to-a-long-random-string

# Seeded system account (source of funds). Change the password!
SYSTEM_EMAIL=system@ledger.local
SYSTEM_PASSWORD=ChangeThisSystemPassword1
# Lets logged-in users top up their own account with demo money (turn OFF in production)
ALLOW_DEMO_FUNDS=true

# ---- Email (optional). false = just log emails to console ----
EMAIL_ENABLED=false
EMAIL_USER=
# Option A (simplest): Gmail App Password (needs 2-Step Verification on)
EMAIL_PASS=
# Option B: OAuth2 (leave EMAIL_PASS empty)
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=

# ---- Production ----
# Business timezone for statements/charts, as a fixed offset
APP_TZ_OFFSET=+05:30
# Run the statement-email scheduler on this instance (safe on many instances; set false on extras to save work)
SCHEDULER_ENABLED=true
DB_POOL_SIZE=20
LOG_LEVEL=info
